{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartInventoryDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },


  //"ConnectionStrings": {
  //  "DefaultConnection": "Server=host.docker.internal;Database=SmartInventoryDB;User Id=sa;Password=1234;TrustServerCertificate=True;"
  //},

  "DatabaseProvider": "SqlServer",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "AllowedOrigins": "http://localhost:4200",

  "Jwt": {
    "Key": "ThisIsMyVeryStrongSecretKey12345",
    "Issuer": "SmartInventoryAPI",
    "Audience": "SmartInventoryClient",
    "DurationInMinutes": 60
  },


  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}